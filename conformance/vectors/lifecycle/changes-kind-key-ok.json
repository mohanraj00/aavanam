              "descriptor_profile": "aavanam/base/v1",
              "kind": "schema",
              "schema_profile": "sample/schema/v1",
              "payload": {
                "$payload": "sa"
              },
              "logical_id": "shared-name"
            }
          },
          {
            "as": "sb",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "schema",
              "schema_profile": "sample/schema/v1",
              "payload": {
                "$payload": "sb"
              },
              "logical_id": "schema-b"
            }
          },
          {
            "as": "ra",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "artifact",
              "artifact_type": "sample/rule-companion/v1",
              "payload": {
                "$payload": "ra"
              },
              "logical_id": "shared-name"
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          },
          {
            "status": "ok",
            "reasons": []
          },
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "bs",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "binding-set",
              "logical_id": "bindings",
              "bindings": {
                "text": {
                  "$ref": "ra"
                }
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "u",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "knowledge-unit",
              "logical_id": "unit",
              "binding_set": {
                "$ref": "bs"
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "create_snapshot",
      "request": {
        "collection": "handbook",
        "schemas": [
          {
            "$ref": "sa"
          },
          {
            "$ref": "sb"
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      },
      "as_ref": "s1"
    },
    {
      "operation": "create_snapshot",
      "request": {
        "collection": "handbook",
        "schemas": [
          {
            "$ref": "sb"
          }
        ],
        "units": [
          {
            "$ref": "u"
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
