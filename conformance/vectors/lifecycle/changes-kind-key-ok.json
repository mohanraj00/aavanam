      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "kind": "artifact",
              "logical_id": "shared-name",
              "change": "added",
              "before": [],
              "after": [
                {
                  "$ref": "ra"
                }
              ]
            }
          },
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "kind": "binding-set",
              "logical_id": "bindings",
              "change": "added",
              "before": [],
              "after": [
                {
                  "$ref": "bs"
                }
              ]
            }
          },
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "kind": "knowledge-unit",
              "logical_id": "unit",
              "change": "added",
              "before": [],
              "after": [
                {
                  "$ref": "u"
                }
              ]
            }
          },
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "kind": "schema",
              "logical_id": "shared-name",
              "change": "removed",
              "before": [
                {
                  "$ref": "sa"
                }
              ],
              "after": []
            }
          }
        ]
      }
    }
  ]
}
