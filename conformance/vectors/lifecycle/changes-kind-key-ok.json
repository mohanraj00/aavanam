{
  "format": "aavanam-vector/v1",
  "title": "One logical ID with a different kind in each snapshot gives one removed and one added item, in kind order",
  "clauses": [
    "LIF-ITM-1",
    "LIF-ITM-2",
    "LIF-ITM-3",
    "LIF-ITM-4",
    "LIF-CHG-1",
    "LIF-CHG-3",
    "LIF-CHG-4"
  ],
  "provenance": {
    "type": "spec",
    "note": "Derived from the cited clauses and the planted data."
  },
  "profile": "aavanam/base/v1",
  "payloads": {
    "sa": {
      "media_type": "application/json",
      "text": "{\"fields\": [\"part\"]}"
    },
    "sb": {
      "media_type": "application/json",
      "text": "{\"fields\": [\"bolt\"]}"
    },
    "ra": {
      "media_type": "text/plain",
      "text": "sample narrative\n"
    }
  },
  "steps": [
    {
      "operation": "put",
