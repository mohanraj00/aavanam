{
  "format": "aavanam-vector/v1",
  "title": "A BindingSet that binds a stored table is accepted",
  "clauses": [
    "KND-DEP-1",
    "KND-REF-2",
    "DAT-PRF-1"
  ],
  "provenance": {
    "type": "spike",
    "note": "Positive pair of the binding regressions. The closure of the BindingSet contains the bound table.",
    "source": "a pre-build prototype"
  },
  "profile": "aavanam/base/v1",
  "payloads": {
    "schema": {
      "media_type": "application/json",
      "text": "{\"fields\": [\"key\", \"value\"]}"
    },
    "table": {
      "media_type": "text/csv",
      "text": "key,value\nalpha,1\nbeta,2\n"
    }
  },
  "steps": [
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "s",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "schema",
              "schema_profile": "sample/schema/v1",
              "payload": {
                "$payload": "schema"
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "t",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "data-resource",
              "data_profile": "sample/table/v1",
              "schema": {
                "$ref": "s"
              },
              "payload": {
                "$payload": "table"
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "b",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "binding-set",
              "bindings": {
                "data": {
                  "$ref": "t"
                }
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    }
  ]
}
