{
  "format": "aavanam-vector/v1",
  "title": "A data resource with a field that is not in its schema is refused",
  "clauses": [
    "KND-SCH-2",
    "DAT-PRF-1"
  ],
  "provenance": {
    "type": "spike",
    "note": "The spike review found that unknown resource fields were accepted. The base profile rejects them.",
    "source": "a pre-build prototype"
  },
  "profile": "aavanam/base/v1",
  "payloads": {
    "schema": {
      "media_type": "application/json",
      "text": "{\"fields\": [\"key\", \"value\"]}"
    },
    "table": {
      "media_type": "text/csv",
      "text": "key,value\nalpha,1\nbeta,2\n"
    }
  },
  "steps": [
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "s",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "schema",
              "schema_profile": "sample/schema/v1",
              "payload": {
                "$payload": "schema"
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "data-resource",
              "data_profile": "sample/table/v1",
              "schema": {
                "$ref": "s"
              },
              "payload": {
                "$payload": "table"
              },
              "rows": [
                [
                  "alpha",
                  "1"
                ]
              ]
            }
          }
        ]
      },
      "expect": {
        "status": "failed",
        "reasons": [
          "unknown_field"
        ],
        "items": [
          {
            "status": "failed",
            "reasons": [
              "unknown_field"
            ]
          }
        ],
        "store_unchanged": true
      }
    }
  ],
  "pair": "regressions/resource-table-ok"
}
