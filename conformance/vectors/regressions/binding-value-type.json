{
  "format": "aavanam-vector/v1",
  "title": "A binding value that is not a reference gives a typed failure",
  "clauses": [
    "KND-SCH-4",
    "STS-MAL-1"
  ],
  "provenance": {
    "type": "spike",
    "note": "The spike review found untyped failures for malformed input. A malformed binding gives field_type.",
    "source": "a pre-build prototype"
  },
  "profile": "aavanam/base/v1",
  "payloads": {
    "schema": {
      "media_type": "application/json",
      "text": "{\"fields\": [\"key\", \"value\"]}"
    },
    "table": {
      "media_type": "text/csv",
      "text": "key,value\nalpha,1\nbeta,2\n"
    }
  },
  "steps": [
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "s",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "schema",
              "schema_profile": "sample/schema/v1",
              "payload": {
                "$payload": "schema"
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "t",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "data-resource",
              "data_profile": "sample/table/v1",
              "schema": {
                "$ref": "s"
              },
              "payload": {
                "$payload": "table"
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "binding-set",
              "bindings": {
                "data": 7
              }
            }
          }
        ]
      },
      "expect": {
        "status": "failed",
        "reasons": [
          "field_type"
        ],
        "items": [
          {
            "status": "failed",
            "reasons": [
              "field_type"
            ]
          }
        ],
        "store_unchanged": true
      }
    }
  ],
  "pair": "regressions/binding-table-ok"
}
