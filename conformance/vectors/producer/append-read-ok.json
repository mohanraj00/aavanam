{
  "format": "aavanam-vector/v1",
  "title": "A log keeps its entries in sequence order, and each log has its own sequence",
  "clauses": [
    "PRD-LOG-1",
    "PRD-LOG-2",
    "PRD-LOG-3"
  ],
  "provenance": {
    "type": "spec",
    "note": "The entries come back in the order of PRD-LOG-3. A log with no entry gives no items."
  },
  "profile": "aavanam/base/v1",
  "steps": [
    {
      "operation": "producer_append",
      "request": {
        "producer": "example/run-writer",
        "log": [
          "answers",
          "k-packet",
          "k-reviewer"
        ],
        "sequence": 1,
        "entry": "eyJhbnN3ZXIiOiJ5ZXMifQ=="
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "sequence": 1
            }
          }
        ]
      }
    },
    {
      "operation": "producer_append",
      "request": {
        "producer": "example/run-writer",
        "log": [
          "answers",
          "k-packet",
          "k-reviewer"
        ],
        "sequence": 2,
        "entry": "eyJhbnN3ZXIiOiJubyJ9"
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "sequence": 2
            }
          }
        ]
      }
    },
    {
      "operation": "producer_append",
      "request": {
        "producer": "example/run-writer",
        "log": [
          "answers",
          "k-packet",
          "k-second"
        ],
        "sequence": 1,
        "entry": "eyJhbnN3ZXIiOiJ5ZXMifQ=="
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "sequence": 1
            }
          }
        ]
      }
    },
    {
      "operation": "producer_read",
      "request": {
        "producer": "example/run-writer",
        "log": [
          "answers",
          "k-packet",
          "k-reviewer"
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "sequence": 1,
              "entry": "eyJhbnN3ZXIiOiJ5ZXMifQ=="
            }
          },
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "sequence": 2,
              "entry": "eyJhbnN3ZXIiOiJubyJ9"
            }
          }
        ]
      }
    },
    {
      "operation": "producer_read",
      "request": {
        "producer": "example/run-writer",
        "log": [
          "splits",
          "k-set"
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": []
      }
    }
  ]
}
