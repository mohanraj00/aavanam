{
  "format": "aavanam-vector/v1",
  "title": "An open_context with a head and a layer opens a layered context on the head snapshot",
  "clauses": [
    "LYR-OPN-1",
    "LYR-OPN-2",
    "CTX-VIW-2",
    "LYR-PRE-2"
  ],
  "provenance": {
    "type": "spec",
    "note": "Derived from the cited clauses and the definition of the fixture site-handbook."
