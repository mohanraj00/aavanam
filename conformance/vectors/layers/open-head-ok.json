      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "ref": {
                "$ref": "base"
              }
            }
          },
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "ref": {
                "$ref": "layer-north"
              }
            }
          }
        ]
      },
      "as_context": "n"
