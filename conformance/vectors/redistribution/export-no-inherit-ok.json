{
  "format": "aavanam-vector/v1",
  "title": "A statement about a source does not apply to its reading or excerpt, and their descriptors stay in the bundle",
  "clauses": [
    "BUN-RED-2",
    "BUN-RED-3",
    "BUN-RED-4",
    "BUN-RED-5",
    "BUN-EXP-2"
  ],
  "provenance": {
    "type": "spec",
    "note": "Only the source has a statement. The reading and the excerpt are undeclared (BUN-RED-3) and withheld. Their descriptors stay, so the excerpt keeps its parent and the reading keeps its source in the bundle (BUN-RED-5)."
  },
  "profile": "aavanam/base/v1",
  "payloads": {
    "src": {
      "media_type": "text/plain",
      "text": "Sample source bytes."
    },
    "rd": {
      "media_type": "text/plain",
      "text": "Sample part one. Sample part two."
    },
    "ex": {
      "media_type": "text/plain",
      "text": "Sample part two."
    }
  },
  "steps": [
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "src",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "source",
              "payload": {
                "$payload": "src"
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "rd",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "reading",
              "source": {
                "$ref": "src"
              },
              "producer": "sample/reader/v1",
              "coverage_profile": "aavanam/coverage/v1",
              "payload": {
                "$payload": "rd"
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "ex",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "excerpt",
              "parent": {
                "$ref": "rd"
              },
              "ranges": [
                {
                  "start": 17,
                  "end": 33
                }
              ],
              "payload": {
                "$payload": "ex"
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "o-src",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "observation",
              "subjects": [
                {
                  "$ref": "src"
                }
              ],
              "observation_type": "aavanam/redistribution/v1",
              "scope": {},
              "values": {
                "license": "sample-license-1",
                "redistribution": "redistributable"
              }
            }
          },
          {
            "as": "o-note",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "observation",
              "subjects": [
                {
                  "$ref": "ex"
                }
              ],
              "observation_type": "sample/note/v1",
              "scope": {},
              "values": {
                "note": "cited part"
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          },
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "snap",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "snapshot",
              "collection": "sample-licensed",
              "observations": [
                {
                  "$ref": "o-src"
                },
                {
                  "$ref": "o-note"
                }
              ]
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "open_context",
      "as_context": "c",
      "request": {
        "roots": [
          {
            "$ref": "snap"
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": []
      }
    },
    {
      "operation": "export",
      "request": {
        "context": {
          "$context": "c"
        },
        "roots": [
          {
            "$ref": "snap"
          }
        ],
        "permit": [
          "redistributable"
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "unordered": true,
        "items": [
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "ref": {
                "$ref": "src"
              },
              "redistribution": "redistributable",
              "license": "sample-license-1",
              "withheld": false
            }
          },
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "ref": {
                "$ref": "rd"
              },
              "redistribution": "undeclared",
              "license": null,
              "withheld": true
            }
          },
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "ref": {
                "$ref": "ex"
              },
              "redistribution": "undeclared",
              "license": null,
              "withheld": true
            }
          },
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "ref": {
                "$ref": "o-src"
              },
              "redistribution": "no_payload",
              "license": null,
              "withheld": false
            }
          },
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "ref": {
                "$ref": "o-note"
              },
              "redistribution": "no_payload",
              "license": null,
              "withheld": false
            }
          },
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "ref": {
                "$ref": "snap"
              },
              "redistribution": "no_payload",
              "license": null,
              "withheld": false
            }
          }
        ]
      }
    }
  ]
}
