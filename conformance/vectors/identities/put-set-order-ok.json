{
  "format": "aavanam-vector/v1",
  "title": "A set in another order and an empty set give the same revision",
  "clauses": [
    "IDN-CAN-1",
    "IDN-CAN-3",
    "KND-SCH-3",
    "KND-SCH-5"
  ],
  "provenance": {
    "type": "spec",
    "note": "Derived from the cited clauses."
  },
  "profile": "aavanam/base/v1",
  "payloads": {
    "schema": {
      "media_type": "application/json",
      "text": "{\"fields\": [\"key\", \"value\"]}"
    },
    "schema2": {
      "media_type": "application/json",
      "text": "{\"fields\": [\"key\", \"value\", \"unit\"]}"
    }
  },
  "steps": [
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "s1",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "schema",
              "schema_profile": "sample/schema/v1",
              "payload": {
                "$payload": "schema"
              }
            }
          },
          {
            "as": "s2",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "schema",
              "schema_profile": "sample/schema/v1",
              "payload": {
                "$payload": "schema2"
              }
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          },
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "as": "x",
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "snapshot",
              "collection": "sample-collection-a",
              "schemas": [
                {
                  "$ref": "s1"
                },
                {
                  "$ref": "s2"
                }
              ]
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": []
          }
        ]
      }
    },
    {
      "operation": "put",
      "request": {
        "descriptors": [
          {
            "value": {
              "descriptor_profile": "aavanam/base/v1",
              "kind": "snapshot",
              "collection": "sample-collection-a",
              "schemas": [
                {
                  "$ref": "s2"
                },
                {
                  "$ref": "s1"
                }
              ],
              "units": []
            }
          }
        ]
      },
      "expect": {
        "status": "ok",
        "reasons": [],
        "items": [
          {
            "status": "ok",
            "reasons": [],
            "fields": {
              "ref": {
                "$ref": "x"
              }
            }
          }
        ],
        "store_unchanged": true
      }
    }
  ]
