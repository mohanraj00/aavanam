FROM --platform=$BUILDPLATFORM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
ARG SOURCE_DATE_EPOCH=0
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS TARGETARCH
RUN GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
    go build -mod=readonly -trimpath -buildvcs=false -ldflags="-s -w" -o /aavanam-server ./cmd/aavanam-server \
    && touch -d "@${SOURCE_DATE_EPOCH}" /aavanam-server

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
LABEL org.opencontainers.image.source="https://github.com/mohanraj00/aavanam"
COPY --from=build /aavanam-server /aavanam-server
USER nonroot
ENTRYPOINT ["/aavanam-server"]
